PL/SQL Developer Test script 3.0
210
declare
    c_assertion_failed_error        constant pls_integer := -20000;
    c_no_error                      constant pls_integer := 0;
    c_invalid_argument_error        constant pls_integer := phr_anylob_exc.CE_Invalid_Argument;
    c_value_error                   constant pls_integer := -6502;
    c_invalid_lob_length_error      constant pls_integer := -21560;
    c_null_self_error               constant pls_integer := -30625;
    c_invalid_data_type_error       constant pls_integer := phr_anylob_exc.CE_Invalid_Data_Type;
    c_flag_yes                      constant varchar2(1) := 'Y';
    c_flag_no                       constant varchar2(1) := 'N';
    c_length_less                   constant number := -0.1;
    c_length_greater                constant number := 0.1;
    c_level_nonbuffered             constant pls_integer := 0;
    c_level_double                  constant pls_integer := 1;
    c_level_tripple                 constant pls_integer := 2;
    c_chunk_length                  constant pls_integer := 1000;
    c_big_chunk_count               constant pls_integer := trunc(32767 / c_chunk_length) + 1;
    c_big_length                    constant pls_integer := c_big_chunk_count * c_chunk_length;
    c_threshold                     constant pls_integer := 32767;
    c_small_secondary_buffer_size   constant pls_integer := 2;
    c_charset                       constant varchar2(32) := 'AL32UTF8';
    c_charset_name_length_limit     constant pls_integer := 32;
    l_lob                           phr_blob;
    l_result                        phr_blob;
    l_error                         pls_integer;
    procedure assert_true
        ( i_name                        in varchar2
        , i_condition                   in boolean )
    is
    begin
        if i_condition then
            dbms_output.put_line('PASS '||i_name);
        else
            raise_application_error(c_assertion_failed_error, 'FAIL '||i_name);
        end if;
    end;

    procedure assert_number
        ( i_name                        in varchar2
        , i_expected                    in number
        , i_actual                      in number )
    is
    begin
        if i_expected = i_actual or (i_expected is null and i_actual is null) then
            dbms_output.put_line('PASS '||i_name);
        else
            raise_application_error(c_assertion_failed_error, 'FAIL '||i_name||': expected ['||i_expected||'] actual ['||i_actual||']');
        end if;
    end;

    procedure assert_flag
        ( i_name                        in varchar2
        , i_expected                    in varchar2
        , i_actual                      in varchar2 )
    is
    begin
        if i_expected = i_actual or (i_expected is null and i_actual is null) then
            dbms_output.put_line('PASS '||i_name);
        else
            raise_application_error(c_assertion_failed_error, 'FAIL '||i_name||': expected ['||i_expected||'] actual ['||i_actual||']');
        end if;
    end;

    procedure assert_value
        ( i_name                        in varchar2
        , i_expected                    in raw
        , i_actual                      in raw )
    is
    begin
        if i_expected = i_actual or (i_expected is null and i_actual is null) then
            dbms_output.put_line('PASS '||i_name);
        else
            raise_application_error(c_assertion_failed_error, 'FAIL '||i_name||': expected ['||rawtohex(i_expected)||'] actual ['||rawtohex(i_actual)||']');
        end if;
    end;

    function new_lob
        ( i_value                       in raw default null )
        return phr_blob
    is
        l_result                        phr_blob := phr_blob.new_tmp_lob();
    begin
        l_result.append(i_value);
        return l_result;
    end;

    function native_lob
        ( i_value                       in raw default null )
        return blob
    is
        l_result                        blob;
    begin
        dbms_lob.createTemporary(
            lob_loc => l_result,
            cache => true
        );

        if i_value is not null then
            dbms_lob.writeAppend(
                lob_loc => l_result,
                amount => utl_raw.length(i_value),
                buffer => i_value
            );
        end if;

        return l_result;
    end;

    function native_lob_of_length
        ( i_length                      in pls_integer )
        return blob
    is
        l_result                        blob := native_lob();
        l_remaining                     pls_integer := i_length;
        l_amount                        pls_integer;
    begin
        while l_remaining > 0 loop
            l_amount := least(l_remaining, c_chunk_length);
            dbms_lob.writeAppend(
                lob_loc => l_result,
                amount => l_amount,
                buffer => hextoraw('')
            );
            l_remaining := l_remaining - l_amount;
        end loop;

        return l_result;
    end;

    function new_lob_at_level
        ( i_level                       in pls_integer )
        return phr_blob
    is
    begin
        return case i_level
            when c_level_nonbuffered then phr_blob.new_tmp_lob().nonbuffered()
            when c_level_double then phr_blob.new_tmp_lob().double_buffered()
            else phr_blob.new_tmp_lob().tripple_buffered(i_buffer_size => c_small_secondary_buffer_size)
        end;
    end;

    function big_native_lob
        return blob
    is
        l_result                        blob := native_lob();
    begin
        for i in 1..c_big_chunk_count loop
            dbms_lob.writeAppend(
                lob_loc => l_result,
                amount => c_chunk_length,
                buffer => hextoraw('')
            );
        end loop;

        return l_result;
    end;
begin
    -- arrange
    l_lob := phr_blob.new_tmp_lob();

    -- act
    l_result := l_lob.with_raw_conversion_charset(c_charset);

    -- assert
    assert_true(i_name => 'charset is set on the result', i_condition => l_result.raw_conversion_charset$ = c_charset);
    assert_true(i_name => 'original untouched', i_condition => l_lob.raw_conversion_charset$ is null);

    -- act
    l_result := l_result.with_raw_conversion_charset('AL16UTF16');

    -- assert
    assert_true(i_name => 'last one wins', i_condition => l_result.raw_conversion_charset$ = 'AL16UTF16');

    -- act
    l_result := l_result.with_raw_conversion_charset(null);

    -- assert
    assert_true(i_name => 'NULL charset resets the setting', i_condition => l_result.raw_conversion_charset$ is null);

    -- act
    l_result := l_lob.with_raw_conversion_charset(c_charset).append(hextoraw('616263'));

    -- assert
    assert_true(i_name => 'charset survives appends', i_condition => l_result.raw_conversion_charset$ = c_charset);
    assert_value(i_name => 'charset does not influence regular appends', i_expected => hextoraw('616263'), i_actual => l_result.subStr(1));

    -- act
    l_result := l_lob.with_raw_conversion_charset(c_charset).double_buffered().tripple_buffered().nonbuffered();

    -- assert
    assert_true(i_name => 'charset survives buffering switches', i_condition => l_result.raw_conversion_charset$ = c_charset);

    -- act
    begin
        l_result := l_lob.with_raw_conversion_charset(rpad('x', c_charset_name_length_limit + 1, 'x'));
        l_error := c_no_error;
    exception
        when others then
            l_error := sqlcode;
    end;

    -- assert
    assert_number(i_name => 'charset name over the length limit is rejected', i_expected => c_value_error, i_actual => l_error);

    -- act
    l_result := l_lob.with_raw_conversion_charset(rpad('x', c_charset_name_length_limit, 'x'));

    -- assert
    assert_number(i_name => 'charset name of the length limit', i_expected => c_charset_name_length_limit, i_actual => length(l_result.raw_conversion_charset$));
end;
